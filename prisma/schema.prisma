generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Guest {
  id           String   @id @default(cuid())
  code         String?  @unique // mã trong link riêng: wedding-0001
  guestType    String   @default("BOTH") // BOTH, GROOM (chỉ nhà trai), BRIDE (chỉ nhà gái)
  invitePrefix String   @default("Thân mời") // Thân mời / Kính mời / ... (hiện ở tiêu đề khi chia sẻ link)
  name         String
  status       String   @default("CHUA_XAC_NHAN") // CHUA_XAC_NHAN, THAM_GIA, KHONG_THAM_GIA
  guestCount   Int      @default(1)
  attendBride  Boolean  @default(false) // tham dự tiệc nhà gái (Hải Phòng, 18.10)
  attendGroom  Boolean  @default(false) // tham dự tiệc nhà trai (Hà Nội, 25.10)
  needShuttle  Boolean  @default(false) // cần xe đưa đón đến tiệc nhà gái
  shuttleCount Int      @default(0)
  message      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Wish {
  id        String   @id @default(cuid())
  guestId   String? // khách (link) đã gửi lời chúc này; một link có thể gửi nhiều lời
  fromRsvp  Boolean  @default(false) // lời nhắn nhập ở form RSVP (mỗi khách tối đa 1, được cập nhật khi trả lời lại)
  name      String
  content   String
  createdAt DateTime @default(now())

  @@index([guestId])
}
